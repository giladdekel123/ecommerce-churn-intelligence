  "missing_value_strategy": "Preserve in Crew 1; fit imputation inside Crew 2 training folds only",
  "category_alias_mappings": {},
  "raw_category_policy": "Preserve distinct labels without mapping; string allowlists pin observed snapshot labels, not synonyms",
  "unknown_units_policy": "Do not guess; no unit transformation authorized",
  "numeric_range_policy": "Only semantic lower bounds (nonnegative where meaningful) and score range 1..5; do not derive incidental upper bounds",
  "required_training_preprocessing": "Split first; fit imputation, one-hot encoding and any scaling only in training folds",
  "known_limitations": [
    "Churn is a historical flag with no documented forward prediction horizon",
    "Some measurement units are not independently verified",
    "Historical Churn flag lacks a documented future prediction horizon",
    "Demographic/location fields are retained in data but excluded from modeling",
    "Case-specific category mappings have not been independently established",
    "V2 accepts any workbook with a verified run receipt and passing content; provenance is weaker than the V1 pinned-file rule"
  ],
  "semantic_demo": "Separate version-controlled synthetic months-to-years test; do not infer units from Kaggle workbook",
