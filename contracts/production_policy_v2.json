  "source_integrity": {
    "mode": "run_receipt",
    "receipt_file": "source_receipt.json",
    "rule": "The gate recomputes SHA-256 from the bytes of the workbook stored in the run's source/ folder, requires it to equal the run-specific receipt written by deterministic application code, and requires the contract's source_sha256 to equal it. Neither Crew 1, its agents, nor a generated contract may supply or change the expected fingerprint."
  },
